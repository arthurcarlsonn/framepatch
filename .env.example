# IGDB, via a Twitch application: https://dev.twitch.tv/console/apps
# Used only by `pnpm sync` at author time — never at request time, never in the browser.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Crawlora — PlayStation platforms, editions and price fallback: https://crawlora.net
# Optional: without it every other source still syncs.
CRAWLORA_API_KEY=

# Firecrawl — the discovery layer behind `pnpm enrich`: https://firecrawl.dev
# Searches and scrapes in one call. Roughly 15-20 credits per title enriched.
# Without it, patch detection still runs and caches; nothing gets verified.
FIRECRAWL_API_KEY=

# OpenRouter — turns the pages Firecrawl returns into structured, quoted frame rate figures.
# https://openrouter.ai. Required by `pnpm enrich`.
OPENROUTER_API_KEY=
# Optional override; defaults to openai/gpt-5.6-luna.
FRAMEPATCH_EXTRACT_MODEL=
